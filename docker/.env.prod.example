# Prod compose env template — copy to the repo root as .env on the host:
#
#   cp docker/.env.prod.example .env
#
# The repo root .env is gitignored and is read twice by docker/docker-compose.prod.yml:
# as the interpolation file (--env-file .env) and as each service's env_file.
# Never commit a real .env.

# --- Compose-level (interpolation) ------------------------------------------
POSTGRES_USER=sa
POSTGRES_PASSWORD=change-me-64-char-random
POSTGRES_DB=support_agent
# Caddy site address + TLS (internal CA unless the Caddyfile is swapped).
SITE_ADDRESS=support-agent.internal.company
# Public dashboard origin baked into the web build (rebuild web when it changes).
NEXT_PUBLIC_API_URL=https://support-agent.internal.company

# --- API runtime -------------------------------------------------------------
APP_URL=https://support-agent.internal.company
# Service names, not localhost — resolved on the compose network.
DATABASE_URL=postgres://sa:change-me-64-char-random@postgres:5432/support_agent
REDIS_URL=redis://redis:6379
AUTH_SESSION_SECRET=change-me-64-char-random

CHATWOOT_BASE_URL=https://chatwoot.internal.company
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_BOT_TOKEN=
CHATWOOT_WEBHOOK_SECRET=change-me-48-char-random

LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENROUTER_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4.1-mini
COMPANY_NAME=Acme Support
DIGEST_WEBHOOK_URL=

UPLOAD_DIR=/data/uploads
LOG_LEVEL=info
WORKER_CONCURRENCY=4
