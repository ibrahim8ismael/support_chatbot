# Prod compose env template — copy to the repo root as .env on the host:
#
#   cp docker/.env.prod.example .env
#
# The repo root .env is gitignored and is read twice by docker/docker-compose.prod.yml:
# as the interpolation file (--env-file .env) and as each service's env_file.
# Never commit a real .env.

# --- Compose-level (interpolation) ------------------------------------------
POSTGRES_USER=sa
POSTGRES_PASSWORD=change-me-64-char-random
POSTGRES_DB=support_agent
# Caddy site address + TLS (internal CA unless the Caddyfile is swapped).
SITE_ADDRESS=support-agent.internal.company
# Public dashboard origin baked into the web build (rebuild web when it changes).
NEXT_PUBLIC_API_URL=https://support-agent.internal.company

# --- API runtime -------------------------------------------------------------
APP_URL=https://support-agent.internal.company
# Service names, not localhost — resolved on the compose network.
# Replace the password with the same value as POSTGRES_PASSWORD.
DATABASE_URL=postgres://sa:change-me-64-char-random@postgres:5432/support_agent
# Redis: internal-only, but compose requires auth anyway (requirepass).
# Generate on the host: openssl rand -hex 32 — hex so it sits safely in the URL.
REDIS_PASSWORD=change-me-redis-64-char-random
REDIS_URL=redis://:change-me-redis-64-char-random@redis:6379

CHATWOOT_BASE_URL=https://chatwoot.internal.company
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_BOT_TOKEN=
# Generate: openssl rand -hex 32 (≥32 chars in production). Empty → webhooks 404.
# The reply pipeline is a stub until T-201: the endpoint answers 501 and drops
# nothing else — do not wire production inboxes yet (docs/integrations/chatwoot.md).
CHATWOOT_WEBHOOK_SECRET=

# mock (fake models) is rejected in production — openai, openrouter, gemini,
# or vertex. Embeddings stay with OpenAI (D3), so openrouter/gemini/vertex also
# need OPENAI_API_KEY.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY is accepted as an alias for GEMINI_API_KEY.
# Vertex AI chat (LLM_PROVIDER=vertex) — pick one auth mode:
#   express mode: GOOGLE_VERTEX_API_KEY (project/location not needed)
#   ADC: GOOGLE_VERTEX_PROJECT + GOOGLE_VERTEX_LOCATION, with Google Cloud
#        credentials via GOOGLE_APPLICATION_CREDENTIALS (mount the file into
#        the api container) or workload identity
GOOGLE_VERTEX_API_KEY=
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=
GOOGLE_APPLICATION_CREDENTIALS=
EMBEDDING_MODEL=text-embedding-3-small
# Optional: defaults to gpt-4.1-mini (openai), openai/gpt-4.1-mini
# (openrouter), or gemini-3.8-flash (gemini/vertex).
CHAT_MODEL=
# Required in production — fills {{company_name}} in answers.
COMPANY_NAME=
# Global daily cap on paid dashboard AI requests (playground/search); 0 disables
LLM_DAILY_REQUEST_LIMIT=3000

DIGEST_WEBHOOK_URL=

UPLOAD_DIR=/data/uploads
LOG_LEVEL=info
WORKER_CONCURRENCY=4
