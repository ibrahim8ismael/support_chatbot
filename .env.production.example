# ==============================================================================
# Support Agent AI - Production Environment Variables Template
# ==============================================================================
# Store in /root/support-agent/.env on the production host.
# File permissions should be restricted: chmod 600 .env
# Never commit real credentials or secrets to source control.
# ==============================================================================

# --- Application Runtime & Environment ---
NODE_ENV=production
APP_URL=https://support-agent.imtelak.com
SITE_ADDRESS=support-agent.imtelak.com
NEXT_PUBLIC_API_URL=https://support-agent.imtelak.com
PORT=3001
LOG_LEVEL=info
WORKER_CONCURRENCY=4

# --- Database & Redis (Isolated Docker Bridge Network) ---
POSTGRES_USER=sa
# Generate: openssl rand -hex 32
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=support_agent
DATABASE_URL=postgres://sa:your_secure_postgres_password_here@postgres:5432/support_agent

# Redis with requirepass
# Generate: openssl rand -hex 32
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_URL=redis://:your_secure_redis_password_here@redis:6379

# --- AI Provider Configuration ---
# Options: openai | gemini | openrouter | mock
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=
OPENROUTER_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4.1-mini
COMPANY_NAME=Imtelak
LLM_DAILY_REQUEST_LIMIT=3000

# --- Chatwoot Integration ---
CHATWOOT_BASE_URL=https://chatwoot-new.imtelak.com
CHATWOOT_ACCOUNT_ID=8
CHATWOOT_BOT_TOKEN=
# Generate: openssl rand -hex 32 (min 32 characters)
CHATWOOT_WEBHOOK_SECRET=your_secure_random_webhook_secret_here

# --- Storage & Operations ---
UPLOAD_DIR=/data/uploads
DIGEST_WEBHOOK_URL=
ALERT_WEBHOOK_URL=
RETENTION_DAYS=365
