    "@ai-sdk/provider": "^4.0.29",
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@node-rs/argon2": "^2.2.2",
    "@support-agent/shared": "workspace:*",
    "ai": "^7.0.143",
    "axios": "^1.20.0",
    "bullmq": "^6.3.16",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
