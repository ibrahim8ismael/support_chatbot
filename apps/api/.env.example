# Keep in sync with the repo-root .env.example (this file is the in-app copy).
# Local values go in .env.local (never committed).

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3001

# --- Postgres (matches docker/docker-compose.yml dev defaults) -------------
DATABASE_URL=postgres://sa:sa@localhost:5432/support_agent

# --- Redis — db 0 = BullMQ queue, db 1 = cache (ADR-0006) ------------------
REDIS_URL=redis://localhost:6379

# --- Chatwoot (optional; configure before enabling a bound inbox) ----------
CHATWOOT_BASE_URL=
CHATWOOT_ACCOUNT_ID=
# Agent Bot API token — sends customer replies, notes, and labels.
CHATWOOT_BOT_TOKEN=
# Optional Chatwoot user API token — only used to discover inboxes in dashboard.
CHATWOOT_ACCOUNT_API_TOKEN=
# Agent Bot signing secret from Chatwoot (required when signed webhooks are enabled).
CHATWOOT_WEBHOOK_SIGNING_SECRET=
# Separate long random path segment in this app's webhook URL.
CHATWOOT_WEBHOOK_SECRET=dev-webhook-secret

# --- Models (`mock` makes no external calls and needs no keys) -------------
# openai: chat + embeddings. openrouter: chat via OpenRouter (`vendor/model`
# ids). gemini: chat via Google Gemini. vertex: chat via Google Vertex AI.
# Embeddings always stay with OpenAI (D3), so openrouter/gemini/vertex also
# need OPENAI_API_KEY. `mock` is dev/test only: production refuses to boot in
# mock mode.
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY is accepted as an alias for GEMINI_API_KEY.
# Vertex AI chat (LLM_PROVIDER=vertex) — pick one auth mode:
#   express mode: GOOGLE_VERTEX_API_KEY (project/location not needed)
#   ADC: GOOGLE_VERTEX_PROJECT + GOOGLE_VERTEX_LOCATION, with Google Cloud
#        credentials via GOOGLE_APPLICATION_CREDENTIALS (or workload identity /
#        `gcloud auth application-default login`)
GOOGLE_VERTEX_API_KEY=
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=
GOOGLE_APPLICATION_CREDENTIALS=
EMBEDDING_MODEL=text-embedding-3-small
# Optional: defaults to gpt-4.1-mini (openai), openai/gpt-4.1-mini
# (openrouter), or gemini-3.8-flash (gemini/vertex).
CHAT_MODEL=
# Brand name substituted into the answer prompt's {{company_name}}
COMPANY_NAME=Acme Support
# Global daily cap on paid dashboard AI requests (playground/search); 0 disables
LLM_DAILY_REQUEST_LIMIT=3000
# Weekly top-unanswered digest (Mondays 09:00 UTC) — Slack-compatible webhook
# receiving {"text": "..."}. Leave empty to log the digest instead of posting.
DIGEST_WEBHOOK_URL=
# Retention for messages/events (NFR-7, days; documents live until deleted)
RETENTION_DAYS=365
# Ops alert webhook (Slack-compatible {"text": "..."}); empty = log alerts as warnings
ALERT_WEBHOOK_URL=
# Suppress repeats of the same condition for this many minutes
ALERT_COOLDOWN_MINUTES=30
# Alert when Redis memory exceeds this many MB (used when maxmemory is unset)
ALERT_REDIS_MEMORY_MB=460

# --- Misc ------------------------------------------------------------------
UPLOAD_DIR=./data/uploads
LOG_LEVEL=info
WORKER_CONCURRENCY=4
