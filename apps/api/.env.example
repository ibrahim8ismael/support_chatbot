# Keep in sync with the repo-root .env.example (this file is the in-app copy).
# Local values go in .env.local (never committed).

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3001

# --- Postgres (matches docker/docker-compose.yml dev defaults) -------------
DATABASE_URL=postgres://sa:sa@localhost:5432/support_agent

# --- Redis — db 0 = BullMQ queue, db 1 = cache (ADR-0006) ------------------
REDIS_URL=redis://localhost:6379

# --- Chatwoot (optional for local dev without a live instance) -------------
CHATWOOT_BASE_URL=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_BOT_TOKEN=
CHATWOOT_WEBHOOK_SECRET=dev-webhook-secret

# --- Models (`mock` makes no external calls and needs no keys) -------------
# openai: chat + embeddings. openrouter: chat via OpenRouter (`vendor/model`
# ids). gemini: chat via Google Gemini. Embeddings always stay with OpenAI
# (D3), so openrouter/gemini also need OPENAI_API_KEY. `mock` is dev/test only:
# production refuses to boot in mock mode.
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY is accepted as an alias for GEMINI_API_KEY.
EMBEDDING_MODEL=text-embedding-3-small
# Optional: defaults to gpt-4.1-mini (openai), openai/gpt-4.1-mini
# (openrouter), or gemini-3.8-flash (gemini).
CHAT_MODEL=
# Brand name substituted into the answer prompt's {{company_name}}
COMPANY_NAME=Acme Support
# Global daily cap on paid dashboard AI requests (playground/search); 0 disables
LLM_DAILY_REQUEST_LIMIT=3000
# Weekly top-unanswered digest (Mondays 09:00 UTC) — Slack-compatible webhook
# receiving {"text": "..."}. Leave empty to log the digest instead of posting.
DIGEST_WEBHOOK_URL=

# --- Misc ------------------------------------------------------------------
UPLOAD_DIR=./data/uploads
LOG_LEVEL=info
WORKER_CONCURRENCY=4
