# Keep in sync with the repo-root .env.example (this file is the in-app copy).
# Local values go in .env.local (never committed).

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3001

# --- Postgres (matches docker/docker-compose.yml dev defaults) -------------
DATABASE_URL=postgres://sa:sa@localhost:5432/support_agent

# --- Redis — db 0 = BullMQ queue, db 1 = cache (ADR-0006) ------------------
REDIS_URL=redis://localhost:6379

# --- Auth — 64-char random in real environments ----------------------------
AUTH_SESSION_SECRET=dev-only-change-me-0123456789abcdef0123456789abcdef

# --- Chatwoot (optional for local dev without a live instance) -------------
CHATWOOT_BASE_URL=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_BOT_TOKEN=
CHATWOOT_WEBHOOK_SECRET=dev-webhook-secret

# --- Models (`mock` makes no external calls and needs no keys) -------------
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SELF_HOSTED_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4.1-mini
# Brand name substituted into the answer prompt's {{company_name}}
COMPANY_NAME=Acme Support

# --- Misc ------------------------------------------------------------------
UPLOAD_DIR=./data/uploads
LOG_LEVEL=info
WORKER_CONCURRENCY=4
